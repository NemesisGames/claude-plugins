{
  "name": "neo4j-memory",
  "version": "0.6.0",
  "description": "Persistent graph memory for Claude Code, backed by Neo4j Agent Memory. Recalls relevant context at session start and before each prompt, and captures entities, preferences, and decisions as you work.",
  "author": {
    "name": "Alejandro Huerta",
    "email": "a.huerta@xsolla.com"
  },
  "keywords": ["memory", "neo4j", "knowledge-graph", "context", "recall"],
  "license": "MIT",
  "mcpServers": {
    "neo4j-memory": {
      "command": "${NEO4J_MEMORY_CMD:-neo4j-agent-memory}",
      "args": [
        "mcp", "serve",
        "--profile", "extended",
        "--session-strategy", "persistent"
      ],
      "env": {
        "NEO4J_URI": "${NAM_NEO4J__URI:-bolt://localhost:7687}",
        "NEO4J_USER": "${NAM_NEO4J__USERNAME:-neo4j}",
        "NEO4J_PASSWORD": "${NAM_NEO4J__PASSWORD}",
        "NEO4J_DATABASE": "${NAM_NEO4J__DATABASE:-neo4j}",
        "NAM_LLM": "${NAM_LLM:-anthropic/claude-sonnet-4-5}",
        "NAM_EMBEDDING": "${NAM_EMBEDDING:-BAAI/bge-base-en-v1.5}",
        "NAM_EMBEDDING__PROVIDER": "${NAM_EMBEDDING__PROVIDER:-sentence_transformers}",
        "NAM_EMBEDDING__DIMENSIONS": "${NAM_EMBEDDING__DIMENSIONS:-768}",
        "NAM_EXTRACTION__LLM_MODEL": "${NAM_EXTRACTION__LLM_MODEL:-anthropic/claude-sonnet-4-5}",
        "NAM_EXTRACTION__ENABLE_SPACY": "${NAM_EXTRACTION__ENABLE_SPACY:-true}",
        "NAM_EXTRACTION__ENABLE_GLINER": "${NAM_EXTRACTION__ENABLE_GLINER:-true}",
        "NAM_EXTRACTION__ENABLE_LLM_FALLBACK": "${NAM_EXTRACTION__ENABLE_LLM_FALLBACK:-true}"
      }
    }
  }
}
