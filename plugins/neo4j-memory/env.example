# neo4j-memory plugin configuration
#
# These must be present in the environment Claude Code inherits -- the hooks
# and the MCP server both read them. Put them in your shell profile
# (~/.zshrc, ~/.bashrc) or, on Windows, set them as user environment
# variables via System Properties or:
#
#   setx NAM_NEO4J__URI "neo4j+s://xxxx.databases.neo4j.io"
#
# A .env file alone will NOT work: hooks are spawned by Claude Code, not by a
# shell that would source it.

# --- Neo4j connection (required) ---------------------------------------
NAM_NEO4J__URI=neo4j+s://xxxxxxxx.databases.neo4j.io
NAM_NEO4J__USERNAME=neo4j
NAM_NEO4J__PASSWORD=your-password-here
NAM_NEO4J__DATABASE=neo4j

# --- LLM for entity extraction and session distillation ----------------
NAM_LLM=anthropic/claude-sonnet-4-5
NAM_LLM_API_KEY=sk-ant-...
# ANTHROPIC_API_KEY is read as a fallback if NAM_LLM_API_KEY is unset.

# --- Embeddings (local, no API key, nothing leaves your machine) -------
# 768 dimensions. Same model family supermemory self-hosted defaults to.
# First run downloads ~440MB to your HuggingFace cache.
NAM_EMBEDDING=BAAI/bge-base-en-v1.5
NAM_EMBEDDING__PROVIDER=sentence_transformers
NAM_EMBEDDING__MODEL=BAAI/bge-base-en-v1.5
NAM_EMBEDDING__DIMENSIONS=768
NAM_EMBEDDING__DEVICE=cpu

# --- Extraction pipeline -----------------------------------------------
# spaCy and GLiNER run locally and catch most entities for free. The LLM
# fallback is what makes the Anthropic key worth having -- it handles the
# ambiguous cases the local models miss.
NAM_EXTRACTION__ENABLE_SPACY=true
NAM_EXTRACTION__ENABLE_GLINER=true
NAM_EXTRACTION__ENABLE_LLM_FALLBACK=true

# --- Plugin behaviour (optional) ---------------------------------------
# NEO4J_MEMORY_RECALL_BUDGET=6.0      # seconds before a recall gives up
# NEO4J_MEMORY_THRESHOLD=0.72         # similarity floor for recall
# NEO4J_MEMORY_MIN_PROMPT_CHARS=25    # skip recall on short prompts
# NEO4J_MEMORY_MAX_ITEMS=6            # max items per recall section
# NEO4J_MEMORY_DEBUG=1                # log to ~/.claude/neo4j-memory.log
